# Cloudflare API認証情報 (デプロイスクリプトが使用する)。
#
# 1. https://dash.cloudflare.com/profile/api-tokens で「カスタムトークンを作成」し、
#    以下の権限を付与する:
#      - Account > Workers Scripts > Edit
#      - Account > Workers KV Storage > Edit
#      - Account > D1 > Edit
#      - Account > Cloudflare Pages > Edit
# 2. このファイルを `.cloudflare.env` としてリポジトリルートにコピーし、値を埋める。
#    (`.cloudflare.env` は .gitignore 済みでコミットされない)
# 3. `chmod 600 .cloudflare.env`
#
# Account ID はトークンさえあれば `npx wrangler whoami` の出力からも確認できる。

export CLOUDFLARE_API_TOKEN=
export CLOUDFLARE_ACCOUNT_ID=
