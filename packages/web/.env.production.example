# 本番ビルド用環境変数。
# Cloudflare Pages の場合は、このファイルをコピーするのではなく
# ダッシュボード (Settings > Environment variables) にビルド環境変数として登録するのが基本。
# ローカルから `npm run deploy` する場合は `cp .env.production.example .env.production` して値を埋める。
#
# 各変数の意味・デフォルト値は src/config/env.ts を参照。ここに無い変数は
# .env.example (ローカル開発用) にも同じ意味で存在する。

# デプロイ済みの packages/api のURL (npm run deploy の出力に表示される workers.dev ドメイン、
# または独自ドメインを設定した場合はそちらを指定する)
VITE_API_BASE_URL=https://hono-bbs.<your-subdomain>.workers.dev
VITE_API_BASE_PATH=/api/v1

# Cloudflare Turnstile (ENABLE_TURNSTILE=true でバックエンドを運用する場合に必須)
VITE_TURNSTILE_SITE_KEY=your-production-site-key
VITE_DISABLE_TURNSTILE=false
# GET /auth/turnstile のURL (通常は VITE_API_BASE_URL + /api/v1/auth/turnstile)
VITE_TURNSTILE_TOKEN_URL=https://hono-bbs.<your-subdomain>.workers.dev/api/v1/auth/turnstile

# 画像アップロード機能 (空文字/コメントアウトで機能自体を非表示。backendの画像アップロード設定と対応させる)
# VITE_IMAGE_UPLOADER_URL=https://hono-bbs.<your-subdomain>.workers.dev/api/v1

# キャッシュ世代 (ローカルストレージのスキーマを変更した際にインクリメントし、古いキャッシュを無効化する)
# VITE_THREAD_CACHE_GEN=20
# VITE_POST_CACHE_GEN=30

# 削除されたレスの表示設定 (空文字またはコメントアウトするとAPIの値をそのまま表示)
# VITE_DELETED_POST_NAME=（削除）
# VITE_DELETED_POST_ID=（削除）
# VITE_DELETED_POST_BODY=このレスは削除されました

# アプリブランディング
# VITE_APP_NAME=AnonBoard
# VITE_APP_ICON=/icon.png       # サイドバー等に表示するアイコン（publicディレクトリに配置したpng/svgファイルのパス）
# VITE_APP_FAVICON=/favicon.png # ブラウザタブのfavicon（未設定時は /favicon.svg を使用）
