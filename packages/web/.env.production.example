# 本番ビルド用環境変数。
# Cloudflare Pages の場合は、このファイルをコピーするのではなく
# ダッシュボード (Settings > Environment variables) にビルド環境変数として登録するのが基本。
# ローカルから `npm run deploy` する場合は `cp .env.production.example .env.production` して値を埋める。

# デプロイ済みの packages/api のURL (npm run deploy の出力に表示される workers.dev ドメイン、
# または独自ドメインを設定した場合はそちらを指定する)
VITE_API_BASE_URL=https://hono-bbs.<your-subdomain>.workers.dev
VITE_API_BASE_PATH=/api/v1

# Cloudflare Turnstile の本番サイトキー (ENABLE_TURNSTILE=true でバックエンドを運用する場合)
VITE_TURNSTILE_SITE_KEY=your-production-site-key
VITE_DISABLE_TURNSTILE=false
