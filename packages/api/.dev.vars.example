# このファイルをコピーして .dev.vars を作成してください
# cp .dev.vars.example .dev.vars

# ────────────────────────────────────────────────────────────
# 認証・セキュリティ
# ────────────────────────────────────────────────────────────

# admin ユーザーの初期パスワード (POST /auth/setup で使用)
ADMIN_INITIAL_PASSWORD=password

# Turnstileを本番相当で有効にする場合は true に設定
# true のとき (1) 書き込み系エンドポイントでX-Turnstile-SessionヘッダーをKVで検証する、
# (2) POST /auth/turnstileが本物のCloudflare siteverifyを呼び出す、の両方が有効になる。
# 未設定または false のときは両方スキップする (ローカル開発時は未設定推奨)
# ENABLE_TURNSTILE=true

# ────────────────────────────────────────────────────────────
# システムID設定 (デフォルト値から変更する場合のみ設定)
# 変更する場合は init.sql の INSERT 文も合わせて変更すること
# ────────────────────────────────────────────────────────────

# 管理者ユーザID (デフォルト: admin)
# ADMIN_USERNAME=admin

# ユーザ管理ロールID (デフォルト: user-admin-role)
# USER_ADMIN_ROLE=user-admin-role

# ────────────────────────────────────────────────────────────
# API 設定
# ────────────────────────────────────────────────────────────

# APIベースパス (wrangler.jsonc の vars.API_BASE_PATH を上書き可)
# API_BASE_PATH=/api/v1

# 許可する CORS オリジン (カンマ区切りで複数指定可)
# 本番環境は wrangler secret put CORS_ORIGIN で設定することを推奨
# packages/web と packages/admin を両方ローカルで同時起動すると、Viteが5173を早い者勝ちで
# 使うためどちらかが5174/5175等にずれる。両方同時に開発する場合は複数ポートを並べておくとよい。
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# 許可するドメイン (カンマ区切りで複数指定可、未設定時は制限なし)
# BBS_ALLOW_DOMAIN=localhost:8787,example.com

# リクエストサイズ上限 (例: "1mb", "500kb", 省略時は無制限)
# MAX_REQUEST_SIZE=1mb

# ────────────────────────────────────────────────────────────
# 表示設定
# ────────────────────────────────────────────────────────────

# ユーザ一覧ページネーション件数 (0=無制限)
# USER_DISPLAY_LIMIT=0

# ロール一覧ページネーション件数 (0=無制限)
# ROLE_DISPLAY_LIMIT=0

# ────────────────────────────────────────────────────────────
# KV プレフィックス (複数インスタンスで同一 KV を共有する場合)
# ────────────────────────────────────────────────────────────

# KV グローバルプレフィックス (例: "prod:" → "prod:session:{id}" になる)
# KV_PREFIX=

